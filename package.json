{
  "name": "blazemap-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "admin:provision": "tsx src/provision.ts",
    "uploads:cleanup": "tsx src/cleanup.ts",
    "sources:sync": "tsx src/sync.ts",
    "sources:osm": "tsx src/spatial-sync.ts",
    "sources:watch": "tsx src/watch.ts",
    "seed:areas": "tsx src/seed-areas.ts",
    "seed:test-accounts": "tsx src/seed-test-accounts.ts",
    "seed:sample-operations": "tsx src/seed-sample-operations.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.4",
    "cors": "2.8.6",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.0",
    "helmet": "8.3.0",
    "nodemailer": "10.0.9",
    "osm-pbf-parser": "2.3.0",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.10.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
